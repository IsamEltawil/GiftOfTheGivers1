@page
@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="bg-gotg-green text-white p-4 text-center">
                    <h3 class="fw-bold mb-1"><i class="bi bi-box-arrow-in-right text-warning me-2"></i>Sign In</h3>
                    <p class="small text-light opacity-75 mb-0">Gift of the Givers Portal</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form action="/Employee/Dashboard" method="get">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email Address</label>
                            <input type="email" class="form-control" value="employee@gotg.org" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Password</label>
                            <input type="password" class="form-control" value="••••••••" required />
                        </div>
                        <button type="submit" class="btn btn-gotg-green btn-lg w-100 mb-3 shadow-sm">Sign In</button>
                        <div class="text-center small text-muted">
                            Don't have an account? <a href="/Account/Register" class="text-gotg-green fw-bold">Register</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>