@page
@{
    ViewData["Title"] = "Section 18A Tax Certificate";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <a href="/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Return Home
        </a>
        <button onclick="window.print()" class="btn btn-gotg-green shadow-sm">
            <i class="bi bi-printer-fill me-1"></i> Print / Download PDF
        </button>
    </div>

    <!-- Printable Official Section 18A Template -->
    <div class="card border p-4 p-md-5 bg-white shadow rounded-3">
        <div class="row border-bottom pb-4 mb-4 align-items-center">
            <div class="col-sm-8">
                <h3 class="text-gotg-green fw-bold mb-1">GIFT OF THE GIVERS FOUNDATION</h3>
                <p class="small text-muted mb-0">Official Section 18A Donation Tax Certificate (South Africa)</p>
                <p class="small text-muted mb-0">PBO Registration No: 930018993 | NPO Reg: 028-877</p>
            </div>
            <div class="col-sm-4 text-sm-end mt-3 mt-sm-0">
                <span class="badge bg-light text-dark border p-2 font-monospace fs-6">GOTG-18A-77492B</span>
                <div class="small text-muted mt-1">Date: 28 August 2026</div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <h6 class="text-uppercase text-muted small fw-bold">Donor Details</h6>
                <p class="fs-5 fw-bold mb-1">Valued Donor (Individual / Corporate)</p>
                <p class="mb-1 text-muted">Email: donor@example.com</p>
                <p class="mb-0 text-muted">Tax / ID No: SARS-98218841</p>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <h6 class="text-uppercase text-muted small fw-bold">Allocated Programme</h6>
                <p class="fs-5 fw-bold text-gotg-green mb-1">General Disaster Relief Fund</p>
                <p class="mb-0 text-muted">Donation Schedule: One-Time</p>
            </div>
        </div>

        <table class="table table-bordered my-3">
            <thead class="table-light">
                <tr>
                    <th>Relief Description</th>
                    <th>Payment Method</th>
                    <th>Frequency</th>
                    <th class="text-end">Amount Contributed</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Humanitarian Emergency Disaster Response</td>
                    <td>Electronic Funds Transfer (Prototype)</td>
                    <td>One-Time</td>
                    <td class="text-end fw-bold fs-5 text-gotg-green">ZAR 250.00</td>
                </tr>
            </tbody>
        </table>

        <div class="p-3 bg-light rounded small text-muted my-3 border">
            <em>Certification:</em> Gift of the Givers Foundation hereby confirms receipt of the donation detailed above. This receipt is issued in terms of Section 18A of the Income Tax Act 58 of 1962 for tax deduction purposes.
        </div>

        <div class="row pt-4 mt-4 border-top align-items-end">
            <div class="col-6">
                <div class="border-bottom pb-2 mb-1" style="width: 220px;">
                    <span class="fst-italic font-monospace text-secondary">Dr. Imtiaz Sooliman</span>
                </div>
                <small class="text-muted">Authorised Representative Signature</small>
            </div>
            <div class="col-6 text-end">
                <span class="badge bg-success bg-opacity-10 text-success border border-success p-2">
                    <i class="bi bi-shield-check me-1"></i> VERIFIED RECEIPT
                </span>
            </div>
        </div>
    </div>
</div>