
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gift of the Givers Foundation</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        :root {
            --gotg-green: #006837;
            --gotg-green-dark: #004d28;
            --gotg-gold: #FBB03B;
        }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
        .bg-gotg-green { background-color: var(--gotg-green) !important; }
        .text-gotg-green { color: var(--gotg-green) !important; }
        .btn-gotg-gold { background-color: var(--gotg-gold); color: #000; font-weight: 600; border: none; }
        .btn-gotg-gold:hover { background-color: #e59c2b; color: #000; }
        .btn-gotg-green { background-color: var(--gotg-green); color: #fff; font-weight: 600; }
        .btn-gotg-green:hover { background-color: var(--gotg-green-dark); color: #fff; }
        .navbar-nav .nav-link { font-weight: 500; }
        .navbar-nav .nav-link:hover { color: var(--gotg-gold) !important; }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <!-- Header & Navigation Bar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-gotg-green shadow-sm py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/Index">
                    <span class="rounded-circle bg-white text-gotg-green p-2 d-inline-flex justify-content-center align-items-center shadow-sm" style="width: 42px; height: 42px;">
                        <i class="bi bi-heart-pulse-fill fs-5"></i>
                    </span>
                    <div>
                        <span class="fw-bold d-block lh-1 text-white">GIFT OF THE GIVERS</span>
                        <small class="text-warning text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">Humanitarian Relief</small>
                    </div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navContent">
                    <ul class="navbar-nav me-auto ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/About">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Donate">Donate</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Volunteer">Volunteer</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Contact">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" href="/Employee/Dashboard">
                                <i class="bi bi-shield-lock-fill me-1"></i>Employee Portal
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2">
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Account/Login">Sign In</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Account/Register">Register</a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a href="/Donate" class="btn btn-gotg-gold btn-sm px-3 shadow-sm">
                                <i class="bi bi-gift-fill me-1"></i> Donate Now
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Page Body -->
    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light py-4 mt-auto border-top border-secondary">
        <div class="container">
            <div class="row gy-3 align-items-center">
                <div class="col-md-7">
                    <h6 class="text-white fw-bold mb-1">Gift of the Givers Foundation</h6>
                    <p class="small text-secondary mb-0">The largest disaster response non-governmental organisation of African origin.</p>
                </div>
                <div class="col-md-5 text-md-end small text-secondary">
                    <span>Demo Roles: <strong>Donor</strong> (Public/Guest) | <strong>Employee</strong> (<a href="/Employee/Dashboard" class="text-warning">Portal</a>)</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>