@page
@{
    ViewData["Title"] = "About Us";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <h2 class="fw-bold text-gotg-green mb-3">About Gift of the Givers</h2>
            <p class="lead text-secondary">Established in 1992 by Dr. Imtiaz Sooliman, Gift of the Givers is the largest disaster response, non-governmental organisation of African origin.</p>
            <p>Our mandate is unconditional humanitarian assistance delivered with speed, compassion, and precision to all persons in need regardless of race, religion, or background.</p>
        </div>
    </div>
</div>